{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Mindbook global design tokens (W3C DTCG) v2. Concept: a quiet lake at dusk. Materials: mist (cool off-white surfaces), deep water (blue-green ink), tide (calm ocean-blue action), moonlight gold (the one warm accent). Ships light (morning lake) + dark (night lake) themes. All neutrals are cool but soft - never hospital-white, never dead grey.",
  "color": {
    "tide": {
      "$description": "Brand ocean-blue scale (11 steps, light to dark). Step 6 = #33718A is canonical. Interaction color only (CTAs, active states, links, focus) - never status.",
      "1":  { "$type": "color", "$value": "#E4F1F4" },
      "2":  { "$type": "color", "$value": "#C6E2E8" },
      "3":  { "$type": "color", "$value": "#9FCDD7" },
      "4":  { "$type": "color", "$value": "#71B2C1" },
      "5":  { "$type": "color", "$value": "#4E92A6" },
      "6":  { "$type": "color", "$value": "#33718A", "$description": "Primary - canonical Mindbook tide. Text on tide = #F2FAFC." },
      "7":  { "$type": "color", "$value": "#285D73" },
      "8":  { "$type": "color", "$value": "#20495B" },
      "9":  { "$type": "color", "$value": "#183742" },
      "10": { "$type": "color", "$value": "#11262E" },
      "11": { "$type": "color", "$value": "#0A171C" }
    },
    "ink": {
      "$description": "Deep-water slate text scale (light theme). Never pure black.",
      "1": { "$type": "color", "$value": "#213238", "$description": "Primary text" },
      "2": { "$type": "color", "$value": "#5C6E74", "$description": "Secondary text" },
      "3": { "$type": "color", "$value": "#8FA1A6", "$description": "Muted / placeholder" }
    },
    "mist": {
      "canvas":  { "$type": "color", "$value": "#F3F6F6", "$description": "Page canvas (light). Cool off-white, never pure white." },
      "surface": { "$type": "color", "$value": "#FCFEFD", "$description": "Cards, sheets, inputs, elevated surfaces." },
      "hover":   { "$type": "color", "$value": "#EAF0F0", "$description": "Hover / pressed wash." },
      "track":   { "$type": "color", "$value": "#E7EEEE", "$description": "Segmented tracks, progress rails, skeletons, orb base." }
    },
    "border": {
      "default": { "$type": "color", "$value": "#DDE6E5", "$description": "Hairlines and input borders only - never on cards." },
      "soft":    { "$type": "color", "$value": "#E6EDEC", "$description": "Subtle row dividers." }
    },
    "brand":     { "$type": "color", "$value": "{color.tide.6}", "$description": "Alias of tide.6 #33718A." },
    "brand-dim": { "$type": "color", "$value": "rgba(51,113,138,0.10)", "$description": "Tide tint for selected/hover washes and tonal icon frames." },
    "on-brand":  { "$type": "color", "$value": "#F2FAFC", "$description": "Text/icon color on tide fills. Cool near-white." },
    "sage": {
      "$description": "Success / growth / Guide ring. Cool sea-green.",
      "6":       { "$type": "color", "$value": "#4E8D7C" },
      "dim":     { "$type": "color", "$value": "rgba(78,141,124,0.14)" },
      "on-dim":  { "$type": "color", "$value": "#33685A" }
    },
    "peri": {
      "$description": "Info / calm / in-progress. Periwinkle.",
      "6":       { "$type": "color", "$value": "#6B7FB3" },
      "dim":     { "$type": "color", "$value": "rgba(107,127,179,0.13)" },
      "on-dim":  { "$type": "color", "$value": "#4A5C8F" }
    },
    "moon": {
      "$description": "Warmth / celebration glow / attention / the logo drop. Moonlight gold - the one warm note, used sparingly.",
      "6":       { "$type": "color", "$value": "#C9A24B" },
      "dim":     { "$type": "color", "$value": "rgba(201,162,75,0.16)" },
      "on-dim":  { "$type": "color", "$value": "#8A6A1F" }
    },
    "rose": {
      "$description": "Danger / report / destructive. Muted - never alarm-red.",
      "6":       { "$type": "color", "$value": "#C05B5B" },
      "dim":     { "$type": "color", "$value": "rgba(192,91,91,0.10)" },
      "on-dim":  { "$type": "color", "$value": "#9E4343" }
    },
    "storm": {
      "$description": "Story / reflective / Heavy mood. Indigo-storm.",
      "6":       { "$type": "color", "$value": "#4A4E75" },
      "dim":     { "$type": "color", "$value": "rgba(74,78,117,0.12)" },
      "on-dim":  { "$type": "color", "$value": "#3A3D5E" }
    },
    "mood": {
      "$description": "5-step felt mood ramp for check-ins - weather over water. Body-language names, no clinical labels, no emoji.",
      "heavy": { "$type": "color", "$value": "#4A4E75", "$description": "Storm indigo" },
      "low":   { "$type": "color", "$value": "#5C7A99", "$description": "Rain slate" },
      "okay":  { "$type": "color", "$value": "#7F958F", "$description": "Mist green-grey" },
      "good":  { "$type": "color", "$value": "#4E9B8F", "$description": "Clear aqua" },
      "light": { "$type": "color", "$value": "#C9A24B", "$description": "Dawn gold" }
    },
    "dark": {
      "$description": "Night-lake dark theme foundations. Cool deep-water family.",
      "canvas":   { "$type": "color", "$value": "#0F181C" },
      "surface":  { "$type": "color", "$value": "#17232A" },
      "hover":    { "$type": "color", "$value": "#1E2D34" },
      "track":    { "$type": "color", "$value": "#22333B" },
      "border":   { "$type": "color", "$value": "#26363E" },
      "border-soft": { "$type": "color", "$value": "#1D2C33" },
      "ink-1":    { "$type": "color", "$value": "#E7EEF0" },
      "ink-2":    { "$type": "color", "$value": "#9FB2B8" },
      "ink-3":    { "$type": "color", "$value": "#6E8188" },
      "tide":     { "$type": "color", "$value": "#5CA2BC", "$description": "Action in dark. Dark text #0D1A20 on fills." },
      "on-tide":  { "$type": "color", "$value": "#0D1A20" },
      "moon":     { "$type": "color", "$value": "#D9B66A" },
      "sage":     { "$type": "color", "$value": "#6FAE9C" },
      "peri":     { "$type": "color", "$value": "#8B9CC9" },
      "rose":     { "$type": "color", "$value": "#D07A7A" },
      "storm":    { "$type": "color", "$value": "#8489B8" }
    }
  },
  "type": {
    "font": {
      "display": { "$type": "fontFamily", "$value": ["Gambetta", "Georgia", "serif"], "$description": "The app voice - greetings, screen titles, onboarding statements, mood words. A calm literary serif. Rendered at weight 500 (Medium) - never heavier, to stay soft. Fontshare." },
      "ui":      { "$type": "fontFamily", "$value": ["Switzer", "system-ui", "sans-serif"], "$description": "Everything functional - body, labels, buttons, meta. Quiet, legible. Fontshare." }
    },
    "weight": {
      "body":     { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600, "$description": "The weight ceiling for UI (Switzer). Display serif (Gambetta) tops out at 500 - the app never shouts." }
    },
    "size": {
      "caption": { "$type": "dimension", "$value": "12px" },
      "meta":    { "$type": "dimension", "$value": "13px" },
      "body":    { "$type": "dimension", "$value": "15px", "$description": "Default body." },
      "title":   { "$type": "dimension", "$value": "18px" },
      "display-s": { "$type": "dimension", "$value": "22px" },
      "display-m": { "$type": "dimension", "$value": "26px" },
      "display-l": { "$type": "dimension", "$value": "32px" }
    },
    "leading": {
      "reading": { "$type": "number", "$value": 1.6 },
      "ui":      { "$type": "number", "$value": 1.4 }
    }
  },
  "spacing": {
    "$description": "Strict 4px grid. Mobile gutter = 20px. When in doubt, add space, not elements.",
    "1":  { "$type": "dimension", "$value": "4px" },
    "2":  { "$type": "dimension", "$value": "8px" },
    "3":  { "$type": "dimension", "$value": "12px" },
    "4":  { "$type": "dimension", "$value": "16px" },
    "5":  { "$type": "dimension", "$value": "20px" },
    "6":  { "$type": "dimension", "$value": "24px" },
    "8":  { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "chip":    { "$type": "dimension", "$value": "999px" },
    "control": { "$type": "dimension", "$value": "14px", "$description": "Buttons, inputs, selects." },
    "card":    { "$type": "dimension", "$value": "20px", "$description": "Cards and sheets." },
    "media":   { "$type": "dimension", "$value": "12px", "$description": "Photo/media thumbnails only." },
    "circle":  { "$type": "dimension", "$value": "50%", "$description": "Avatars, mood orbs, icon frames." }
  },
  "shadow": {
    "card":  { "$type": "shadow", "$value": { "color": "rgba(35,60,70,0.08)", "offsetX": "0", "offsetY": "2px", "blur": "16px", "spread": "0" }, "$description": "The only card elevation (light). Cool-tinted. Cards never have borders." },
    "sheet": { "$type": "shadow", "$value": { "color": "rgba(15,24,28,0.20)", "offsetX": "0", "offsetY": "-8px", "blur": "40px", "spread": "0" }, "$description": "Bottom sheets." },
    "fab":   { "$type": "shadow", "$value": { "color": "rgba(51,113,138,0.32)", "offsetX": "0", "offsetY": "6px", "blur": "20px", "spread": "0" }, "$description": "Tide glow under the floating compose action." }
  },
  "motion": {
    "default.duration": { "$type": "duration", "$value": "220ms" },
    "default.easing":   { "$type": "cubicBezier", "$value": [0.3, 0, 0.2, 1] },
    "sheet.duration":   { "$type": "duration", "$value": "300ms" },
    "sheet.easing":     { "$type": "cubicBezier", "$value": [0.2, 0.9, 0.25, 1] },
    "breath.duration":  { "$type": "duration", "$value": "3200ms", "$description": "Signature breathing loop - orb + success moments, scale 1 to 1.035 to 1." },
    "ripple.duration":  { "$type": "duration", "$value": "1400ms", "$description": "Signature ripple - a soft ring expands outward once and settles. Splash, Circle reveal, check-in saved." }
  },
  "viewport": {
    "mobile":  { "$type": "dimension", "$value": "390px", "$description": "Primary canvas. 390x844." },
    "desktop": { "$type": "dimension", "$value": "1440px", "$description": "Back office canvas." }
  }
}
