{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Mindbook global design tokens (W3C DTCG). Source of truth for all tooling. Materials: paper (warm cream surfaces), ink (plum-charcoal text), clay (terracotta brand accent). All neutrals are warm-leaning; if a grey reads blue, it is wrong.",
  "color": {
    "clay": {
      "$description": "Brand terracotta scale (11 steps, light to dark). Step 6 = #B9542F is the canonical brand clay. Interaction color only (CTAs, active states, links, focus) - never status.",
      "1":  { "$type": "color", "$value": "#FBEFE8" },
      "2":  { "$type": "color", "$value": "#F6DDCF" },
      "3":  { "$type": "color", "$value": "#EFC3AC" },
      "4":  { "$type": "color", "$value": "#E4A181" },
      "5":  { "$type": "color", "$value": "#D57A55" },
      "6":  { "$type": "color", "$value": "#B9542F", "$description": "Primary - canonical Mindbook clay. Text on clay = #FFF9F4." },
      "7":  { "$type": "color", "$value": "#9C4426" },
      "8":  { "$type": "color", "$value": "#7E361E" },
      "9":  { "$type": "color", "$value": "#602917" },
      "10": { "$type": "color", "$value": "#421C10" },
      "11": { "$type": "color", "$value": "#251008" }
    },
    "ink": {
      "$description": "Warm plum-charcoal text scale. Never pure black.",
      "1": { "$type": "color", "$value": "#2E2433", "$description": "Primary text" },
      "2": { "$type": "color", "$value": "#6E6172", "$description": "Secondary text" },
      "3": { "$type": "color", "$value": "#9C92A1", "$description": "Muted / placeholder" }
    },
    "paper": {
      "canvas":  { "$type": "color", "$value": "#FAF5EE", "$description": "Page canvas. Warm cream - never pure white, never cool." },
      "surface": { "$type": "color", "$value": "#FFFCF8", "$description": "Cards, sheets, inputs, elevated surfaces." },
      "hover":   { "$type": "color", "$value": "#F3ECE3", "$description": "Hover / pressed wash on surfaces." },
      "track":   { "$type": "color", "$value": "#F0E8DD", "$description": "Segmented-control tracks, progress rails, skeletons." }
    },
    "border": {
      "default": { "$type": "color", "$value": "#EBE1D6", "$description": "Hairlines and input borders only - never on cards." },
      "soft":    { "$type": "color", "$value": "#F2EAE0", "$description": "Subtle row dividers." }
    },
    "brand":     { "$type": "color", "$value": "{color.clay.6}", "$description": "Alias of clay.6 #B9542F." },
    "brand-dim": { "$type": "color", "$value": "rgba(185,84,47,0.10)", "$description": "Clay tint for selected/hover washes and tonal icon frames." },
    "on-brand":  { "$type": "color", "$value": "#FFF9F4", "$description": "Text/icon color on clay fills. Warm cream, not pure white." },
    "sage": {
      "$description": "Success / growth / Light mood.",
      "6":       { "$type": "color", "$value": "#5E8C63" },
      "dim":     { "$type": "color", "$value": "rgba(94,140,99,0.14)" },
      "on-dim":  { "$type": "color", "$value": "#3F6B45" }
    },
    "dusk": {
      "$description": "Info / calm / Low mood.",
      "6":       { "$type": "color", "$value": "#567A9B" },
      "dim":     { "$type": "color", "$value": "rgba(86,122,155,0.13)" },
      "on-dim":  { "$type": "color", "$value": "#3E5F7E" }
    },
    "honey": {
      "$description": "Attention / celebration glow / Good mood.",
      "6":       { "$type": "color", "$value": "#D9982B" },
      "dim":     { "$type": "color", "$value": "rgba(217,152,43,0.16)" },
      "on-dim":  { "$type": "color", "$value": "#8A5B0F" }
    },
    "rose": {
      "$description": "Danger / report / destructive. Muted - never alarm-red.",
      "6":       { "$type": "color", "$value": "#C24545" },
      "dim":     { "$type": "color", "$value": "rgba(194,69,69,0.10)" },
      "on-dim":  { "$type": "color", "$value": "#A03030" }
    },
    "mood": {
      "$description": "5-step felt mood ramp for daily check-ins. Body-language names, no clinical labels, no emoji.",
      "heavy": { "$type": "color", "$value": "#4E3A5C", "$description": "Deep plum" },
      "low":   { "$type": "color", "$value": "#567A9B", "$description": "Dusk" },
      "okay":  { "$type": "color", "$value": "#A5907C", "$description": "Warm taupe" },
      "good":  { "$type": "color", "$value": "#D9982B", "$description": "Honey" },
      "light": { "$type": "color", "$value": "#5E8C63", "$description": "Sage" }
    },
    "night": {
      "$description": "Dark-mode foundations (post-MVP). Warm plum-black family.",
      "canvas":  { "$type": "color", "$value": "#211B26" },
      "surface": { "$type": "color", "$value": "#2A2330" }
    }
  },
  "type": {
    "font": {
      "display": { "$type": "fontFamily", "$value": ["Sentient", "Georgia", "serif"], "$description": "The book voice - greetings, screen-title moments, onboarding statements, big mood words. Fontshare." },
      "ui":      { "$type": "fontFamily", "$value": ["Author", "system-ui", "sans-serif"], "$description": "Everything functional - body, labels, buttons, meta. Fontshare." }
    },
    "weight": {
      "body":     { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600, "$description": "The weight ceiling. Nothing renders at 700 in v1." }
    },
    "size": {
      "caption": { "$type": "dimension", "$value": "12px" },
      "meta":    { "$type": "dimension", "$value": "13px" },
      "body":    { "$type": "dimension", "$value": "15px", "$description": "Default body. Support text deserves comfort." },
      "title":   { "$type": "dimension", "$value": "18px" },
      "display-s": { "$type": "dimension", "$value": "22px" },
      "display-m": { "$type": "dimension", "$value": "26px" },
      "display-l": { "$type": "dimension", "$value": "32px" }
    },
    "leading": {
      "reading": { "$type": "number", "$value": 1.6, "$description": "Posts, stories, long copy." },
      "ui":      { "$type": "number", "$value": 1.4 }
    }
  },
  "spacing": {
    "$description": "Strict 4px grid. Mobile gutter = 20px. When in doubt, add space, not elements.",
    "1":  { "$type": "dimension", "$value": "4px" },
    "2":  { "$type": "dimension", "$value": "8px" },
    "3":  { "$type": "dimension", "$value": "12px" },
    "4":  { "$type": "dimension", "$value": "16px" },
    "5":  { "$type": "dimension", "$value": "20px" },
    "6":  { "$type": "dimension", "$value": "24px" },
    "8":  { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "chip":   { "$type": "dimension", "$value": "999px" },
    "control": { "$type": "dimension", "$value": "14px", "$description": "Buttons, inputs, selects." },
    "card":   { "$type": "dimension", "$value": "20px", "$description": "Cards and sheets." },
    "media":  { "$type": "dimension", "$value": "12px", "$description": "Photo/media thumbnails only." },
    "circle": { "$type": "dimension", "$value": "50%", "$description": "Avatars, mood orbs, icon frames." }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": { "color": "rgba(76,54,44,0.08)", "offsetX": "0", "offsetY": "2px", "blur": "16px", "spread": "0" },
      "$description": "The only card elevation. Warm-tinted. Cards never have borders."
    },
    "sheet": {
      "$type": "shadow",
      "$value": { "color": "rgba(46,36,51,0.18)", "offsetX": "0", "offsetY": "-8px", "blur": "40px", "spread": "0" },
      "$description": "Bottom sheets."
    },
    "fab": {
      "$type": "shadow",
      "$value": { "color": "rgba(185,84,47,0.32)", "offsetX": "0", "offsetY": "6px", "blur": "20px", "spread": "0" },
      "$description": "Clay glow under the floating compose action."
    }
  },
  "motion": {
    "default.duration": { "$type": "duration", "$value": "220ms" },
    "default.easing":   { "$type": "cubicBezier", "$value": [0.3, 0, 0.2, 1] },
    "sheet.duration":   { "$type": "duration", "$value": "300ms" },
    "sheet.easing":     { "$type": "cubicBezier", "$value": [0.2, 0.9, 0.25, 1] },
    "breath.duration":  { "$type": "duration", "$value": "3200ms", "$description": "Signature breathing loop - check-in orb and success moments, scale 1 to 1.035 to 1." }
  },
  "viewport": {
    "mobile":  { "$type": "dimension", "$value": "390px", "$description": "Primary canvas. 390x844." },
    "desktop": { "$type": "dimension", "$value": "1440px", "$description": "Back office canvas." }
  }
}
